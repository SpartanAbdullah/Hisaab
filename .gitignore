# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code per-developer config (local permissions, machine paths)
.claude/

# Capacitor Android local/build output
android/.gradle/
android/.idea/
android/local.properties
android/**/build/
android/*.iml
*.apk
*.aab
*.jks
*.keystore

# Release signing — keystore + the passwords file that points to it.
# Both must NEVER be committed. See RELEASE.md for setup.
android/keystore.properties
android/app/*.jks
android/app/*.keystore

# Playwright (e2e/) — local run artifacts and the saved login session.
# e2e/.auth/*.json is a live Supabase storageState (session tokens) written by
# e2e/global-setup.ts — never committed, even for a staging-only account.
/test-results/

# Local design source material (never shipped). The 3dicons webp set that
# was built from here was retired by the 1d/3c redesign (2026-09-18) — icons
# are now inline SVG glyphs in src/lib/glyphs.ts.
assets-src/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/

# Firebase client config for the Android build — environment-specific, and this
# repo is public; each machine that builds a release downloads its own copy
# (docs/push-notifications-setup.md step 2-3).
android/app/google-services.json

# Firebase service-account private keys (downloaded from Project settings ->
# Service accounts). Real credentials: never in the repo, never in the bundle.
*firebase-adminsdk*.json
**/serviceAccountKey*.json
