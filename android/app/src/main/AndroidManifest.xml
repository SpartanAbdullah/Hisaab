<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links — tapped invite URLs from WhatsApp/email
              open the app directly instead of the browser.

              autoVerify="true" tells Android to fetch
              https://usehisaab.com/.well-known/assetlinks.json on first
              install and validate this app's signing fingerprint against
              the file. Until that JSON is published with the correct
              SHA-256 from our release keystore, links will still open in
              a browser (graceful fallback) but the system disambiguation
              dialog will list Hisaab as an option.

              See RELEASE.md sections 5-6 for the assetlinks.json format and
              how to derive the SHA-256 fingerprint (the signing config is read
              from android/keystore.properties).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="usehisaab.com" />
                <data android:pathPrefix="/join/" />
                <!--
                  Connect QR codes (https://usehisaab.com/u/HSB-XXXXXX). A QR
                  scanned with the phone's own camera app hands the URL to the
                  system; with this filter (once assetlinks.json verifies) it
                  opens straight into Hisaab's connect screen instead of the
                  browser. Same graceful fallback as /join/ until then.
                -->
                <data android:pathPrefix="/u/" />
                <!--
                  Public kameti "witness" links (https://usehisaab.com/kameti/witness/TOKEN),
                  shared with committee members/relatives who may not have the
                  app installed yet — src/App.tsx renders KametiWitnessPage for
                  this path without requiring auth. Same graceful browser
                  fallback as the other two prefixes until assetlinks.json
                  verifies.
                -->
                <data android:pathPrefix="/kameti/witness/" />
            </intent-filter>

            <!-- Launcher long-press shortcuts: Add expense, Close today (res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!--
          Home-screen widget: today's status + Add expense / Close today
          (java/com/usehisaab/app/widget/QuickAddWidget.java). Exported so the
          system AppWidgetManager can deliver APPWIDGET_UPDATE; it only
          redraws from the app's own snapshot, so there is nothing to abuse.
        -->
        <receiver
            android:name=".widget.QuickAddWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          FCM builds the tray notification itself while the app is killed, and
          it reads the small icon and its tint from here, not from the app's
          JavaScript. Without these it falls back to a generic bell (seen on
          device 2026-09-05). The edge function also names the same drawable
          in its payload; this is the belt to that brace.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_hisaab" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/hisaab_notification" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      In-app QR scanning for connecting two users face-to-face. Capacitor's
      WebChromeClient turns the WebView's getUserMedia request into this
      runtime permission prompt, so no scanner plugin is needed. Declared as
      NOT required so the app still installs on camera-less devices — the
      scanner degrades to "type the code instead".
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      POST_NOTIFICATIONS is merged in from @capacitor/local-notifications; it
      covers FCM pushes too (one Android 13+ notification permission for the
      whole app).
    -->
</manifest>
