<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget card: the app's dark hero base (#0A0A14) with one
     thin wall, rounded to sit with other launcher widgets. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_stroke" />
    <corners android:radius="20dp" />
</shape>
